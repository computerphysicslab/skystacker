# Local/private AI prompts and working notes
/prompts-ia.txt
/prompts-ia-*.txt

# Build artifacts
/skystacker
/skystacker.exe
/skystacker-race
*.test
*.out

# Go coverage and profiling outputs
coverage.out
coverage.html
*.prof
*.pprof

# SkyStacker processing outputs and working data
0_skystacker_results/
skystacker_results/
**/skystacker_results/
_work/
*.f32raw

# Temporary files and backups
*.tmp
*.temp
*.bak
*.backup
*~
patch_*.py

# Local datasets and large imaging-session data
/datasets/
/data/
/sessions/
# Real astrophotography test dataset (do not commit; keep only locally)
/assets/Orion-135mm/
/assets/OrionNebula/
# Uncomment if you keep astrophotography source frames inside this repository:
*.CR2
*.CR3
*.FIT
*.FITS
*.fit
*.fits

# Environment variables, credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# Python tooling used for local development/scripts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# Editors and operating systems
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace
NEXT_SESSION_PROMPT.md
prompt-ai.txt
ai-context.md

# Go workspace (local multi-module development)
go.work
go.work.sum
assets/M42-2017-11-18-Leciñena-50mm/

